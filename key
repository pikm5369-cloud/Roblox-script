--Script

local bg1 = Main:WaitForChild("Bg1")
local bg2 = Main:WaitForChild("Bg2")

local SPEED = 0.02
local DIRECTION = -1

game:GetService("RunService").RenderStepped:Connect(function(deltaTime)
	local shift = SPEED * deltaTime * DIRECTION
	bg1.Position = bg1.Position + UDim2.new(shift, 0, 0, 0)
	bg2.Position = bg2.Position + UDim2.new(shift, 0, 0, 0)

	if DIRECTION == -1 then
		if bg1.Position.X.Scale <= -1 then
			bg1.Position = UDim2.new(bg2.Position.X.Scale + 1, 0, 0, 0)
		end
		if bg2.Position.X.Scale <= -1 then
			bg2.Position = UDim2.new(bg1.Position.X.Scale + 1, 0, 0, 0)
		end
	end
end)

